# ==============================================================================
# AirSense Environment Configuration Template
# Copy to .env and adjust variables as needed. Do NOT commit production secrets.
# ==============================================================================

APP_ENV=development
SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production
JWT_EXPIRY_HOURS=24
PORT=5000

# Database Configuration (MySQL 8.0)
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=airsense
MYSQL_USER=airsense
MYSQL_PASSWORD=airsense_secure_password
DATABASE_URL=mysql+pymysql://airsense:airsense_secure_password@mysql:3306/airsense

# Air Quality Data Ingestion Provider
# Options: 'open_meteo' (live public CAMS API, no key required), 'mock' (simulated offline mode)
AQI_PROVIDER=open_meteo
AQI_API_KEY=
INGESTION_INTERVAL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=10

# Notification Email Dispatch (Optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=airsense-alerts@example.com

# ML Forecasting
MODEL_PATH=/app/ml/artifacts/random_forest_pm25.joblib

# Operational Monitoring
PROMETHEUS_ENABLED=true
